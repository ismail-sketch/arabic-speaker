# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕ коммитится в git (см. .gitignore).

# API-ключ AnyModel (OpenAI-совместимый шлюз)
ANYMODEL_KEY=

# Базовый URL API (менять не нужно)
ANYMODEL_BASE=https://anymodel.org/v1

# Модель для диалога. Чем быстрее, тем живее разговор:
#   gc/gemini-2.5-flash   ~1 c
#   ag/gemini-2.5-flash   ~2 c
#   glm/glm-5.3-flash     ~2.7 c
#   ds/deepseek-v4-flash  ~6-9 c (reasoning, медленно для диалога)
MODEL=gc/gemini-2.5-flash

# Модель распознавания речи для серверного режима (Firefox, Safari и др.).
# Должна принимать аудио (input_audio). Проверенная: gc/gemini-3.1-flash-lite-preview.
MODEL_TRANSCRIBE=gc/gemini-3.1-flash-lite-preview

# Порт локального сервера
PORT=8787
